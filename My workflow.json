    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let rawText = item.json.content?.parts?.[0]?.text || item.json.text || item.json.message?.content || \"\";\n  rawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n  try {\n    item.json = JSON.parse(rawText);\n  } catch (e) {\n    item.json = { parse_error: true, raw: rawText };\n  }\n}\nreturn $input.all();"
      },
